<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>behavior_executive</name>
  <version>0.1.0</version>
  <description>
    Behavior executive layer between the VLM (target selection) and Nav2:
    runs a fixed library of navigation behaviors (APPROACH_TARGET,
    FOLLOW_TARGET, KEEP_DISTANCE, WAIT, STOP, GO_TO_LAST_SEEN, ROTATE_SCAN,
    SEARCH_TARGET, REPLAN, ABORT_TASK, RETURN_HOME) as an explicit task
    tree with on_failure/on_exhausted recovery chains.
  </description>
  <maintainer email="admin@todo.todo">admin</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf2_geometry_msgs</exec_depend>
  <exec_depend>perception</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
